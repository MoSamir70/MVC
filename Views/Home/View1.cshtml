<!-- C# -->
<!--Firsy Method => Block Code-->
<!--will be removed when rendaring-->
@{
    int x = 10;
    int y = x + 10;

}

<!--Second Method => Inline Statment-->
<h2>@x</h2>
@y

<!--Condition statment-->
@if (x > y) 
{

    <h2>X ggreater than y</h2>
}
else // x = 10
{
    <h2>X = @x Less than y =@y</h2> // printed

}


<!--Looping Statment-->
@for (int i = 0; i < 10; i++)
{
    <li>@i</li>
}

